{
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "[A-Za-z0-9_-]+"
          },
          "kind": {
            "type": "string",
            "enum": [
              "directory"
            ]
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 1000
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 1000
          },
          "schema_filters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 1000
          },
          "resource_filters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "kind",
          "environment",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual",
            "hybrid"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "technologies": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "dialect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "adapter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "properties": {
        "trusted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "plugins": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "technologies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "maxItems": 1000
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "id",
              "path",
              "version",
              "technologies",
              "priority"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "network_enabled": {
          "type": "boolean"
        },
        "allowed_endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 1000
        },
        "redact": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "scan_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "adapter_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "adapter_memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "max_nodes_per_adapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "markdown",
              "html",
              "json"
            ]
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "project",
    "sources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline Handbook config v1"
}
